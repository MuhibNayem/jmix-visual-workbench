<idea-plugin>
    <id>com.jmixstudio.clone</id>
    <name>Jmix Studio Clone</name>
    <version>1.0.0</version>
    <vendor>Open Source</vendor>

    <description><![CDATA[
    Open-source Jmix development studio with visual designers for entities, views,
    CRUD scaffolding, menu, roles, and database migrations. Integrates directly
    into IntelliJ IDEA.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Jmix Studio"
                    anchor="right"
                    factoryClass="com.jmixstudio.toolwindow.JmixStudioToolWindowFactory"
                    icon="/icons/jmix.svg"/>

        <projectService serviceImplementation="com.jmixstudio.services.JmixProjectService"/>
        <projectService serviceImplementation="com.jmixstudio.services.CodeGenerationService"/>
    </extensions>

    <actions>
        <group id="JmixStudio.NewMenu" text="Jmix Studio" popup="true">
            <add-to-group group-id="NewGroup" anchor="last"/>
            <action id="JmixStudio.NewEntity"
                    class="com.jmixstudio.actions.NewEntityAction"
                    text="Entity"
                    description="Create a new Jmix entity visually"/>
            <action id="JmixStudio.NewView"
                    class="com.jmixstudio.actions.NewViewAction"
                    text="View"
                    description="Create a new Jmix view visually"/>
            <action id="JmixStudio.NewCrud"
                    class="com.jmixstudio.actions.NewCrudAction"
                    text="CRUD Screens"
                    description="Generate full CRUD screens for an entity"/>
        </group>

        <action id="JmixStudio.OpenDesigner"
                class="com.jmixstudio.actions.OpenDesignerAction"
                text="Open Jmix Studio Designer"
                description="Open the Jmix Studio visual designer">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
